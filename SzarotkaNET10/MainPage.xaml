<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SzarotkaNET10.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:RangeDay="clr-namespace:Inventory.Pages.RangeDay.Controls;assembly=Inventory"
    xmlns:controls="clr-namespace:Shared.CustomControls;assembly=Shared"
    xmlns:controlsMaps="clr-namespace:DriversRoutes.Pages.Maps.Controls;assembly=DriversRoutes"
    xmlns:img="clr-namespace:Shared.Helper.Img;assembly=Shared"
    xmlns:inventory="clr-namespace:Inventory.Pages.Main;assembly=Inventory"
    xmlns:local="clr-namespace:SzarotkaNET10"
    xmlns:options="clr-namespace:SzarotkaNET10.Pages.Options.Main"
    xmlns:routes="clr-namespace:DriversRoutes.Pages.Main;assembly=DriversRoutes"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:update="clr-namespace:Shared.Pages.UpdateDifference;assembly=Shared">

    <Grid RowDefinitions="auto,*">


        <ScrollView Grid.Row="1">
            <VerticalStackLayout
                Padding="30,0"
                Spacing="25"
                VerticalOptions="Center">

                <Image
                    HeightRequest="100"
                    HorizontalOptions="Center"
                    Source="logo2.png" />

                <Button
                    Clicked="Inventory_Clicked"
                    HorizontalOptions="Center"
                    Text="Inwentarz" />

                <Button
                    Clicked="Maps_Clicked"
                    HorizontalOptions="Center"
                    IsVisible="{OnPlatform Android=true,
                                           Default=false}"
                    Text="Mapy" />

                <Button
                    Clicked="Options_Clicked"
                    HorizontalOptions="Center"
                    Text="Opcje" />

                <Button
                    Clicked="Button_Clicked"
                    HorizontalOptions="Center"
                    Text="Profil" />

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>
