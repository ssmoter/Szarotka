<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<!-- Ogólne ustawienia projektu i kompilacji -->
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<TargetFramework>net10.0</TargetFramework>

		<!-- Lokalizacja i języki (i18n) -->
		<EnableI18n>true</EnableI18n>
		<IncludeLocales>pl-PL</IncludeLocales>
		<InvariantGlobalization>false</InvariantGlobalization>

		<!-- Konfiguracja Native AOT i Serializacji -->
		<IlcRootAnonymousTypes>true</IlcRootAnonymousTypes>
		<!-- Nakazuje kompilatorowi zachować właściwości obiektów anonimowych dla refleksji -->
		<JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
		<PublishAot>true</PublishAot>

		<!-- Analiza kompatybilności z Native AOT (Wymuszenie błędów) -->
		<IsAotCompatible>true</IsAotCompatible>
		<EnableAotAnalyzer>true</EnableAotAnalyzer>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
		<EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
		<!-- IL2026/IL2104: Ostrzeżenia trybu Trimming | IL3050/IL3056: Ostrzeżenia Native AOT -->
		<WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2104;IL3050;IL3056</WarningsAsErrors>
		<Configurations>Debug;Release;ReleaseTest</Configurations>
	</PropertyGroup>

	<!-- Wykluczenia plików (np. skrypty HTTP) -->
	<ItemGroup>
		<Compile Remove="http\**" />
		<Content Remove="http\**" />
		<EmbeddedResource Remove="http\**" />
		<None Remove="http\**" />
	</ItemGroup>

	<!-- Paczki NuGet (posortowane alfabetycznie) -->
	<ItemGroup>
		<PackageReference Include="MailKit" Version="4.18.2" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
		<PackageReference Include="MimeKit" Version="4.18.2" />
	</ItemGroup>

	<!-- Referencje do innych projektów -->
	<ItemGroup>
		<ProjectReference Include="..\DataBase\DataBase.csproj" />
	</ItemGroup>

	<!-- Foldery projektu i usługi systemowe -->
	<ItemGroup>
		<Folder Include="Development\" />
		<Folder Include="Validation\" />
	</ItemGroup>

	<ItemGroup>
		<Service Include="{508349b6-6b84-4df5-91f0-309beebad82d}" />
	</ItemGroup>

</Project>