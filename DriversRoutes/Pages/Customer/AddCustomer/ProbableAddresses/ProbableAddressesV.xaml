<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="DriversRoutes.Pages.Customer.AddCustomer.ProbableAddresses.ProbableAddressesV"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Model="clr-namespace:DataBase.Model.EntitiesRoutes;assembly=DataBase"
    xmlns:VM="clr-namespace:DriversRoutes.Pages.Customer.AddCustomer.ProbableAddresses"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Margin="0"
    Padding="0"
    x:DataType="VM:ProbableAddressesVM"
    BackgroundColor="Transparent"
    CanBeDismissedByTappingOutsideOfPopup="False">

    <!--  Główny kontener z marginesem i zaokrągleniami  -->
    <Border
        Margin="1"
        Padding="1"
        BackgroundColor="{AppThemeBinding Light={StaticResource White},
                                          Dark={StaticResource Black}}"
        HorizontalOptions="Fill"
        MaximumHeightRequest="650"
        StrokeShape="RoundRectangle 12"
        VerticalOptions="Center">

        <Grid RowDefinitions="Auto, *" RowSpacing="12">

            <!--  Górny pasek z tytułem i przyciskiem Anuluj  -->
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="Wybierz adres"
                    VerticalOptions="Center" />

                <Button
                    Grid.Column="1"
                    Command="{Binding CancelAndReturnCommand}"
                    Text="Anuluj" />
            </Grid>

            <!--  Lista adresów  -->
            <CollectionView
                Grid.Row="1"
                ItemsSource="{Binding ProbableAddressesM.ResidentialAddresses}"
                SelectionMode="None">

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="Model:ResidentialAddress">
                        <Border
                            Margin="0,6"
                            Padding="12"
                            StrokeShape="RoundRectangle 8">

                            <!--  7 wierszy (indeksy od 0 do 6)  -->
                            <Grid
                                ColumnDefinitions="Auto, *"
                                ColumnSpacing="10"
                                RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto"
                                RowSpacing="4">

                                <!--  Etykiety (lewa kolumna)  -->
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    FontAttributes="Bold"
                                    Text="Ulica:" />
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    FontAttributes="Bold"
                                    Text="Numer domu:" />
                                <Label
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    FontAttributes="Bold"
                                    Text="Numer mieszkania:" />
                                <Label
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    FontAttributes="Bold"
                                    Text="Kod pocztowy:" />
                                <Label
                                    Grid.Row="4"
                                    Grid.Column="0"
                                    FontAttributes="Bold"
                                    Text="Miasto:" />
                                <Label
                                    Grid.Row="5"
                                    Grid.Column="0"
                                    FontAttributes="Bold"
                                    Text="Kraj:" />

                                <!--  Wartości z modelu (prawa kolumna)  -->
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Text="{Binding Street}" />
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Text="{Binding HouseNumber}" />
                                <Label
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Text="{Binding ApartmentNumber}" />
                                <Label
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Text="{Binding PostalCode}" />
                                <Label
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    Text="{Binding City}" />
                                <Label
                                    Grid.Row="5"
                                    Grid.Column="1"
                                    Text="{Binding Country}" />

                                <!--  Przycisk wyboru w 7. wierszu (indeks 6)  -->
                                <Button
                                    Grid.Row="6"
                                    Grid.ColumnSpan="2"
                                    Margin="0,8,0,0"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type VM:ProbableAddressesVM}}, Path=SaveAndReturnCommand}"
                                    CommandParameter="{Binding .}"
                                    HorizontalOptions="Fill"
                                    Text="Wybierz" />

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </Grid>
    </Border>
</toolkit:Popup>
