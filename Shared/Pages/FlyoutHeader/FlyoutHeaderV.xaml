<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Shared.Pages.FlyoutHeader.FlyoutHeaderV"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:Shared.Pages.FlyoutHeader"
    x:DataType="vm:FlyoutHeaderVM">


    <ContentView.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <toolkit:IsNotNullConverter x:Key="IsNotNullConverter" />
        </ResourceDictionary>
    </ContentView.Resources>

    <Grid RowDefinitions="*,auto">

        <VerticalStackLayout>

            <VerticalStackLayout
                Margin="10"
                Padding="10"
                HorizontalOptions="Center">
                <VerticalStackLayout IsVisible="{Binding IsLogin}">
                    <Label
                        FontSize="Large"
                        HorizontalOptions="Center"
                        Style="{StaticResource LabelPointerOver}"
                        Text="{Binding User.Name}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToUserCommand}" Tapped="TapGestureRecognizer_Tapped" />
                        </Label.GestureRecognizers>
                    </Label>

                </VerticalStackLayout>
                <VerticalStackLayout IsVisible="{Binding IsLogin, Converter={StaticResource InvertedBoolConverter}}">

                    <Label
                        FontSize="Large"
                        HorizontalOptions="Center"
                        Style="{StaticResource LabelPointerOver}"
                        Text="Zaloguj się">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToLoginCommand}" Tapped="TapGestureRecognizer_Tapped" />
                        </Label.GestureRecognizers>
                    </Label>

                </VerticalStackLayout>

            </VerticalStackLayout>

            <Border HorizontalOptions="Fill" />


        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1" IsVisible="{Binding CustomContent, Converter={StaticResource IsNotNullConverter}}">

            <ContentView Content="{Binding CustomContent}" />
            <Border HorizontalOptions="Fill" />
        </VerticalStackLayout>
    </Grid>
</ContentView>