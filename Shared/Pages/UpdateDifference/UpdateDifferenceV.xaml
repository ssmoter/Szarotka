<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Shared.Pages.UpdateDifference.UpdateDifferenceV"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Shared.CustomControls"
    xmlns:modelInventory="clr-namespace:DataBase.Model.EntitiesInventory;assembly=DataBase"
    xmlns:modelRoutes="clr-namespace:DataBase.Model.EntitiesRoutes;assembly=DataBase"
    xmlns:modelServer="clr-namespace:DataBase.Model.EntitiesServer;assembly=DataBase"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:update="clr-namespace:Shared.Pages.UpdateDifference"
    Title="Różnice"
    x:DataType="update:UpdateDifferenceVM">

    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <toolkit:IsNotNullConverter x:Key="IsNotNullConverter" />

            <DataTemplate x:Key="Customer" x:DataType="modelServer:UpdateDifference">

                <Grid RowDefinitions="auto,*,auto">
                    <Label
                        Grid.Row="0"
                        HorizontalOptions="Center"
                        Text="{Binding Index}" />

                    <update:DriverRoutesUpdate
                        Grid.Row="1"
                        Margin="5"
                        CustomerRoutesServer="{Binding Server}"
                        CustomerRoutesUpdate="{Binding Update}"
                        UpdateBool="{Binding UpdateSelect}" />
                    <Border
                        Grid.Row="2"
                        Grid.ColumnSpan="2"
                        Margin="0"
                        Padding="0"
                        StrokeThickness="2" />
                </Grid>

            </DataTemplate>

            <DataTemplate x:Key="Empty" x:DataType="modelServer:UpdateDifference">

                <Grid RowDefinitions="auto,*,auto">
                    <Label
                        Grid.Row="0"
                        HorizontalOptions="Center"
                        Text="{Binding Index}" />

                    <Label
                        Grid.Row="1"
                        Margin="5"
                        Text="Brak szablonu" />
                    <Border
                        Grid.Row="2"
                        Grid.ColumnSpan="2"
                        Margin="0"
                        Padding="0"
                        StrokeThickness="2" />
                </Grid>

            </DataTemplate>

            <DataTemplate x:Key="ProductName" x:DataType="modelServer:UpdateDifference">

                <Grid RowDefinitions="auto,*,auto">
                    <Label
                        Grid.Row="0"
                        HorizontalOptions="Center"
                        Text="{Binding Index}" />

                    <update:ProductNameUpdate
                        Grid.Row="1"
                        Margin="5"
                        PNameServer="{Binding Server}"
                        PNameUpdate="{Binding Update}"
                        UpdateBool="{Binding UpdateSelect}" />
                    <Border
                        Grid.Row="2"
                        Grid.ColumnSpan="2"
                        Margin="0"
                        Padding="0"
                        StrokeThickness="2" />
                </Grid>

            </DataTemplate>


            <update:DifferenceDataTemplateSelector
                x:Key="DifferenceDataTemplateSelector"
                Customer="{StaticResource Customer}"
                Empty="{StaticResource Empty}"
                PName="{StaticResource ProductName}" />

        </ResourceDictionary>
    </ContentPage.Resources>

    <Shell.BackButtonBehavior>
        <BackButtonBehavior Command="{Binding BackCommand}" />
    </Shell.BackButtonBehavior>

    <Grid ColumnDefinitions="*,*" RowDefinitions="auto,*,auto">

        <Grid
            Grid.Row="0"
            Grid.ColumnSpan="2"
            ColumnDefinitions="*,*"
            RowDefinitions="*,*,*">
            <Label
                Grid.ColumnSpan="3"
                HorizontalOptions="Center"
                Text="Wybierz które wartości danych mają zostać zapisane." />


            <Label
                Grid.Row="1"
                Grid.ColumnSpan="2"
                HorizontalOptions="Center"
                IsVisible="{Binding UpdateDifferences, Converter={StaticResource IsNotNullConverter}}">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Ilość rekordów do poprawy " />
                        <Span Text="{Binding UpdateDifferences.Count}" />
                        <Span Text="." />
                    </FormattedString>
                </Label.FormattedText>
            </Label>


            <Border
                Grid.Row="2"
                Grid.ColumnSpan="3"
                VerticalOptions="End" />

            <Grid
                Grid.Row="2"
                Grid.Column="1"
                ColumnDefinitions="auto,*"
                HorizontalOptions="Center">

                <CheckBox
                    Grid.Row="0"
                    Grid.Column="0"
                    IsChecked="{Binding SelectAllValue}" />
                <Label
                    Grid.Column="1"
                    Text="Dane lokalne"
                    VerticalOptions="Center" />
            </Grid>
            <Grid
                Grid.Row="2"
                Grid.Column="0"
                ColumnDefinitions="auto,*"
                HorizontalOptions="Center">
                <CheckBox
                    Grid.Row="0"
                    Grid.Column="0"
                    IsChecked="{Binding SelectAllValue, Converter={StaticResource InvertedBoolConverter}}" />
                <Label
                    Grid.Column="1"
                    Text="Dane z serwera"
                    VerticalOptions="Center" />
            </Grid>

        </Grid>

        <Grid Grid.Row="2" Grid.ColumnSpan="2">
            <Button Command="{Binding SaveCommand}" Text="Zapisz" />
        </Grid>


        <Grid
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="2">

            <controls:CollectionViewPagination
                IsVisible="{Binding UpdateDifferences, Converter={StaticResource IsNotNullConverter}}"
                ItemTemplate="{StaticResource DifferenceDataTemplateSelector}"
                ItemsSourcePagination="{Binding UpdateDifferences}">

                <controls:CollectionViewPagination.ItemsLayout>
                    <LinearItemsLayout ItemSpacing="10" Orientation="Vertical" />
                </controls:CollectionViewPagination.ItemsLayout>

            </controls:CollectionViewPagination>
        </Grid>

    </Grid>


</ContentPage>