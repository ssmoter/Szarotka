<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Shared.Pages.UserDisplay.UserDisplayV"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:small="clr-namespace:Shared.Pages.UserDisplay.Small"
    xmlns:vm="clr-namespace:Shared.Pages.UserDisplay"
    Title="{Binding User.Name}"
    x:DataType="vm:UserDisplayVM">


    <Grid RowDefinitions="*,auto">
        <small:UserDisplaySmallV Grid.Row="0" User="{Binding User}" />
        <Button
            Grid.Row="1"
            Margin="20"
            Command="{Binding GoToEditCommand}"
            Text="Edytuj" />
    </Grid>


</ContentPage>