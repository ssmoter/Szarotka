<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="Shared.Pages.UserDisplay.PopupUser.UserDisplayVPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:small="clr-namespace:Shared.Pages.UserDisplay.Small"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:Shared.Pages.UserDisplay.PopupUser"
    x:Name="this"
    Margin="0"
    Padding="0"
    x:DataType="vm:UserDisplayVPopup"
    BackgroundColor="Transparent"
    BindingContext="{Reference this}"
    HorizontalOptions="Center"
    VerticalOptions="Center">


    <Border
        Padding="15"
        BackgroundColor="{AppThemeBinding Light={StaticResource White},
                                          Dark={StaticResource Black}}"
        HorizontalOptions="Start"
        StrokeShape="RoundRectangle 12"
        VerticalOptions="Start">

        <RefreshView
            HorizontalOptions="Start"
            IsRefreshing="{Binding IsRefreshing}"
            VerticalOptions="Start">

            <Border
                Padding="10"
                HorizontalOptions="Start"
                StrokeShape="RoundRectangle 8"
                VerticalOptions="Start">

                <Grid
                    HorizontalOptions="Start"
                    RowDefinitions="Auto,Auto"
                    RowSpacing="10"
                    VerticalOptions="Start">

                    <small:UserDisplaySmallV
                        Grid.Row="0"
                        HorizontalOptions="Start"
                        User="{Binding User}" />

                    <Button
                        Grid.Row="1"
                        Clicked="Button_Clicked_Close"
                        HorizontalOptions="Center"
                        Text="Anuluj"
                        WidthRequest="120" />

                </Grid>

            </Border>

        </RefreshView>
    </Border>



</toolkit:Popup>