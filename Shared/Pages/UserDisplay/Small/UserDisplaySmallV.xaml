<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Shared.Pages.UserDisplay.Small.UserDisplaySmallV"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:custom="clr-namespace:Shared.CustomControls"
    xmlns:myConverter="clr-namespace:Shared.Converters"
    xmlns:user="clr-namespace:DataBase.Model.EntitiesServer;assembly=DataBase"
    xmlns:vm="clr-namespace:Shared.Pages.UserDisplay.Small"
    x:Name="this"
    x:DataType="vm:UserDisplaySmallV"
    HorizontalOptions="Start"
    VerticalOptions="Start">

    <ContentView.Resources>
        <ResourceDictionary>
            <myConverter:UserTypeTranslated x:Key="userTypeTranslated" />

        </ResourceDictionary>
    </ContentView.Resources>



    <Border
        x:Name="mBorder"
        Margin="5"
        Padding="10"
        BindingContext="{x:Reference this}"
        HorizontalOptions="Start"
        StrokeShape="RoundRectangle 8"
        VerticalOptions="Start">

        <VerticalStackLayout HorizontalOptions="Start" Spacing="10">

            <!--  Pierwsza sekcja danych  -->
            <Grid
                ColumnDefinitions="Auto,Auto"
                ColumnSpacing="15"
                HorizontalOptions="Start"
                RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                RowSpacing="6">

                <Label
                    Grid.Row="0"
                    Grid.Column="0"
                    Text="Nazwa:" />
                <Label
                    Grid.Row="0"
                    Grid.Column="1"
                    Text="{Binding User.Name}" />

                <BoxView
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    HeightRequest="1"
                    VerticalOptions="Start"
                    Color="{AppThemeBinding Light={StaticResource Gray200},
                                            Dark={StaticResource Gray500}}" />
                <Label
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,5,0,0"
                    Text="Email:" />
                <Label
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,5,0,0"
                    Text="{Binding User.Email}" />

                <BoxView
                    Grid.Row="2"
                    Grid.ColumnSpan="2"
                    HeightRequest="1"
                    VerticalOptions="Start"
                    Color="{AppThemeBinding Light={StaticResource Gray200},
                                            Dark={StaticResource Gray500}}" />
                <Label
                    Grid.Row="2"
                    Grid.Column="0"
                    Margin="0,5,0,0"
                    Text="Opis:" />
                <Label
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="0,5,0,0"
                    Text="{Binding User.Description}" />

                <BoxView
                    Grid.Row="3"
                    Grid.ColumnSpan="2"
                    HeightRequest="1"
                    VerticalOptions="Start"
                    Color="{AppThemeBinding Light={StaticResource Gray200},
                                            Dark={StaticResource Gray500}}" />
                <Label
                    Grid.Row="3"
                    Grid.Column="0"
                    Margin="0,5,0,0"
                    Text="Nr telefonu:" />
                <Label
                    Grid.Row="3"
                    Grid.Column="1"
                    Margin="0,5,0,0"
                    Text="{Binding User.PhoneNumber}" />

                <BoxView
                    Grid.Row="4"
                    Grid.ColumnSpan="2"
                    HeightRequest="1"
                    VerticalOptions="Start"
                    Color="{AppThemeBinding Light={StaticResource Gray200},
                                            Dark={StaticResource Gray500}}" />
                <Label
                    Grid.Row="4"
                    Grid.Column="0"
                    Margin="0,5,0,0"
                    Text="Typ użytkownika:" />
                <Label
                    Grid.Row="4"
                    Grid.Column="1"
                    Margin="0,5,0,0"
                    Text="{Binding User.UserType, Converter={StaticResource userTypeTranslated}}" />

            </Grid>

            <!--  Separator główny  -->
            <BoxView
                HeightRequest="3"
                HorizontalOptions="Fill"
                Color="{AppThemeBinding Light={StaticResource Gray300},
                                        Dark={StaticResource Gray600}}" />

            <!--  Druga sekcja danych  -->
            <Grid
                ColumnDefinitions="Auto,Auto"
                ColumnSpacing="15"
                HorizontalOptions="Start"
                RowDefinitions="Auto,Auto,Auto,Auto"
                RowSpacing="6">

                <Label
                    Grid.Row="0"
                    Grid.Column="0"
                    Text="Id:" />
                <custom:NameOrIdUser
                    Grid.Row="0"
                    Grid.Column="1"
                    UserId="{Binding User.Id}" />


                <BoxView
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    HeightRequest="1"
                    VerticalOptions="Start"
                    Color="{AppThemeBinding Light={StaticResource Gray200},
                                            Dark={StaticResource Gray500}}" />
                <Label
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,5,0,0"
                    Text="Data utworzenia:" />
                <Label
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,5,0,0"
                    Text="{Binding User.Created}" />

                <BoxView
                    Grid.Row="2"
                    Grid.ColumnSpan="2"
                    HeightRequest="1"
                    VerticalOptions="Start"
                    Color="{AppThemeBinding Light={StaticResource Gray200},
                                            Dark={StaticResource Gray500}}" />
                <Label
                    Grid.Row="2"
                    Grid.Column="0"
                    Margin="0,5,0,0"
                    Text="Ostatnia edycja:" />
                <Label
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="0,5,0,0"
                    Text="{Binding User.Updated}" />

                <BoxView
                    Grid.Row="3"
                    Grid.ColumnSpan="2"
                    HeightRequest="1"
                    VerticalOptions="Start"
                    Color="{AppThemeBinding Light={StaticResource Gray200},
                                            Dark={StaticResource Gray500}}" />
                <Label
                    Grid.Row="3"
                    Grid.Column="0"
                    Margin="0,5,0,0"
                    Text="Użytkownik który edytował:" />
                <custom:NameOrIdUser
                    Grid.Row="3"
                    Grid.Column="1"
                    Margin="0,5,0,0"
                    UserId="{Binding User.UserUpdatedId}" />


            </Grid>

        </VerticalStackLayout>
    </Border>

</ContentView>
