<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="Inventory.Pages.SingleDayPreview.SingleDayPreviewPopUp.SingleDayPreviewPopUpV"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:smallDay="clr-namespace:Inventory.Pages.SingleDayPreview.SingleDayPreviewSmall"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Name="this"
    Color="{AppThemeBinding Light={StaticResource White},
                            Dark={StaticResource Black}}">


    <Grid
        Margin="10,10,10,5"
        Padding="10,10,10,5"
        BindingContext="{x:Reference this}"
        HorizontalOptions="Fill"
        RowDefinitions="*,auto"
        VerticalOptions="Start">

        <smallDay:SingleDayPreviewSmallV
            Grid.Row="0"
            Day="{Binding Day}"
            Driver="{Binding Driver}"
            HorizontalOptions="Fill" />

        <Grid Grid.Row="1" ColumnDefinitions="*,*">

            <Button
                Grid.Column="0"
                Clicked="Button_Clicked_Close"
                Text="zamknij" />
            <Button
                Grid.Column="1"
                Clicked="Button_Clicked_Edit"
                Text="Edytuj" />

        </Grid>
    </Grid>


</toolkit:Popup>