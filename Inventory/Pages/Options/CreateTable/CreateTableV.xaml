<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Inventory.Pages.Options.CreateTable.CreateTableV"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:VM="clr-namespace:Inventory.Pages.Options.CreateTable"
    xmlns:modelR="clr-namespace:DataBase.Model.EntitiesRoutes;assembly=DataBase"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Name="View"
    x:DataType="VM:CreateTableVM">

    <Border>
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="10" />
        </Border.StrokeShape>

        <VerticalStackLayout Padding="5">

            <HorizontalStackLayout>
                <Label Text="Ustawiona trasa:" VerticalOptions="Center" />
                <Picker
                    Title="Wybierz trasę"
                    ItemsSource="{Binding Routes}"
                    SelectedItem="{Binding SelectedRoutes}"
                    VerticalOptions="Center">
                    <Picker.ItemDisplayBinding>
                        <Binding Path="Name" />
                    </Picker.ItemDisplayBinding>
                </Picker>
            </HorizontalStackLayout>


            <Label HorizontalOptions="End" VerticalOptions="Start">
                <Label.FormattedText>
                    <FormattedString>
                        <Span FontSize="Micro" Text="Wersja: " />
                        <Span FontSize="Micro" Text="{Binding Version.Inventory}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>

            <Label
                HorizontalOptions="Center"
                Text="Stworzone tabele:"
                VerticalOptions="Center" />
            <CollectionView ItemsSource="{Binding TableMs}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Grid x:DataType="VM:CreateTableM" ColumnDefinitions="auto,*,auto">
                                <Label
                                    Grid.Column="0"
                                    HorizontalTextAlignment="Start"
                                    Text="{Binding TableName}"
                                    VerticalOptions="Center" />
                                <CheckBox
                                    Grid.Column="2"
                                    IsChecked="{Binding IsExist}"
                                    IsEnabled="False"
                                    VerticalOptions="Center"
                                    Color="{Binding Color}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>




        </VerticalStackLayout>
    </Border>

</ContentView>
