<Project Sdk="Microsoft.NET.Sdk.Razor">
	<!-- ========================================================================= -->
	<!-- KONFIGURACJA PROJEKTU I PLATFORM DOCELOWYCH                               -->
	<!-- ========================================================================= -->
	<PropertyGroup>
		<TargetFrameworks>net10.0;net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
		<!-- Uncomment to also build the tizen app. You will need to install tizen by following this: https://github.com -->
		<!-- <TargetFrameworks>$(TargetFrameworks);net8.0-tizen</TargetFrameworks> -->
		<!--
    <UseMaui>true</UseMaui>
    -->
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">14.2</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">14.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>
		<StaticWebAssetsEnabled>true</StaticWebAssetsEnabled>
		<Platforms>AnyCPU;x86;x64</Platforms>
		<Configurations>Debug;Release;ReleaseTest</Configurations>
	</PropertyGroup>

	<PropertyGroup>
		<!-- Analiza kompatybilności z Native AOT i mechanizmem przycinania (Trimming) -->
		<IsAotCompatible>true</IsAotCompatible>
		<EnableAotAnalyzer>true</EnableAotAnalyzer>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
		<EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>

		<!-- Opcjonalne: Traktuj ostrzeżenia AOT jako błędy kompilacji (zablokuje build w przypadku problemów) -->
		<!-- IL2026/IL2104: Ostrzeżenia trybu Trimming | IL3050/IL3056: Ostrzeżenia Native AOT -->
		<WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2104;IL3050;IL3056</WarningsAsErrors>

	</PropertyGroup>

	<!-- ========================================================================= -->
	<!-- ZEWNĘTRZNE PAKIETY NUGET (ZALEŻNOŚCI REPOZYTORIUM)                        -->
	<!-- ========================================================================= -->
	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.120" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.120" />
	</ItemGroup>

	<!-- ========================================================================= -->
	<!-- REFERENCJE DO INNYCH PROJEKTÓW W ROZWIĄZANIU (SLN)                        -->
	<!-- ========================================================================= -->
	<ItemGroup>
		<ProjectReference Include="..\Shared\Shared.csproj" />
	</ItemGroup>

	<!-- ========================================================================= -->
	<!-- STRUKTURA KATALOGÓW PROJEKTU                                              -->
	<!-- ========================================================================= -->
	<ItemGroup>
		<Folder Include="Data\File\" />
	</ItemGroup>

	<!-- ========================================================================= -->
	<!-- KOMPILACJA I AKTUALIZACJA PLIKÓW INTERFEJSU MAUI XAML                     -->
	<!-- ========================================================================= -->
	<ItemGroup>
		<MauiXaml Update="Pages\Main\MainV.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Pages\Options\CreateTable\CreateTableV.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Pages\PopupCalculator\PopupCalculatorV.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Pages\Products\ListProduct\AddEdit\AddEditProductV.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Pages\Products\ListProduct\ListProductV.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Pages\RangeDay\PopupSelectRangeDate\PopupSelectRangeDateV.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Pages\RangeDay\RangeDayV.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Pages\SingleDay\SingleDayV.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Pages\SingleDayPreview\SingleDayPreviewPage\SingleDayPreviewPageV.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Pages\SingleDayPreview\SingleDayPreviewPopUp\SingleDayPreviewPopUpV.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Pages\SingleDayPreview\SingleDayPreviewSmall\SingleDayPreviewSmallV.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
	</ItemGroup>

	<!-- Nie hostujemy bezpośrednio Blazor static web assets w tym projekcie -->
	<!-- Usuń PackageReference do Microsoft.AspNetCore.Components.WebView.Maui, jeśli projekt nie używa BlazorWebView -->
	<!-- Definiujemy puste targety wymagane przez pakiet WebView.Maui, aby uniknąć błędu MSB4057
  <Target Name="StaticWebAssetsPrepareForRun" />
  <Target Name="StaticWebAssetsPrepareForPublish" />
  <Target Name="LoadStaticWebAssetsPublishManifest" />
  -->
</Project>
